<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!--
        TV / Fire TV distribution.

        IMPORTANT - leanback is declared as required="false" so the APK can be
        sideloaded or distributed via the Amazon Appstore on Fire TV, which
        reports android.software.leanback only on newer Fire OS builds.  The
        LEANBACK_LAUNCHER intent-filter is still present so the app appears in
        the TV launcher row on every device that supports it.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Touch / fake-touch: not needed on TV, but mark optional so phones   -->
    <!-- can also sideload if desired.                                        -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!-- Microphone: Fire TV Stick Lite / Basic Edition have no mic.         -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
        Resolution / display capabilities.
        Declaring these as optional allows the APK to install on all screen
        sizes and lets the Amazon Appstore know the app supports 4K.
    -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!--
        4K / UHD support on Fire TV Cube (2nd gen+), Fire TV Stick 4K /
        4K Max, and Android TV boxes.
        These features are optional so the APK installs on 1080p devices too.
    -->
    <uses-feature
        android:name="android.hardware.hdmi"
        android:required="false" />

    <!-- Android 11+ hides implicit intent handlers unless they are declared. -->
    <queries>
        <package android:name="com.discord" />
        <!-- Discord's Android OAuth flow is launched in a Custom Tab. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:name=".TetoTvApplication"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TetoTV"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!--
            Keep this activity and MainActivity on the default application
            task affinity. Discord returns from its app with a NEW_TASK deep
            link; a null/custom affinity would strand that callback outside
            the task holding the SDK's pending authorization session.
        -->
        <activity
            android:name="com.discord.socialsdk.AuthenticationActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="discord-1536801401710055474" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AiringReminderReceiver"
            android:exported="false" />

        <service
            android:name=".DirectTorrentPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <service
            android:name=".OfflineDownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".ExternalPlaybackProxyService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <activity
            android:name=".TrailerPlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/NormalTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Standard Android TV launcher -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Fire TV launcher (also covers Fire TV Cube) -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="app"
                    android:pathPrefix="/anime/"
                    android:scheme="tetotv" />
            </intent-filter>
        </activity>

        <!--
            Tell Fire OS / Android TV the app supports up to 4K UHD.
            The resolution preference is advisory; the system picks the best
            mode the display supports at runtime.
        -->
        <meta-data
            android:name="com.amazon.android.tv.capability.UHD"
            android:value="true" />
        <meta-data
            android:name="com.amazon.android.tv.capability.HDR"
            android:value="true" />

        <!-- Flutter embedding version -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
